{
  "name": "mahjong-score",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build && wrangler dev --local",
    "dev:ui": "vite",
    "typecheck": "tsc -b",
    "build": "npm run typecheck && vite build",
    "preview": "npm run build && wrangler dev --local",
    "deploy": "npm run build && npm run db:migrate:remote && wrangler deploy",
    "deploy:worker": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:create": "wrangler d1 create mahjong-score-db",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "hono": "^4.9.2",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260730.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "wrangler": "^4.27.0"
  },
  "engines": { "node": ">=20" }
}
